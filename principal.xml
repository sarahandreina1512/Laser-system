import { zodResolver } from "@hookform/resolvers/zod";
import { useQueryClient } from "@tanstack/react-query";
import { AlertTriangle } from "lucide-react";
import { useState } from "react";
import { useForm } from "react-hook-form";
import { z } from "zod";
import { api, apiError, type ApiError, type Client } from "../api";
import { useToast } from "../store";
import { Button, Modal, errCls, inputCls } from "../ui";

const ALLERGIES = ["Ninguna", "Embarazo", "Diabetes", "Queloides", "Epilepsia", "Marcapasos", "Medicación fotosensibilizante", "Látex"];
const schema = z.object({
  full_name: z.string().trim().min(3, "Mínimo 3 caracteres"),
  national_id: z.string().trim().regex(/^[A-Za-z]?-?\d{5,12}$/, "Cédula inválida (ej. V12345678)"),
  phone: z.string().trim().min(7, "Teléfono inválido"),
  allergies_conditions: z.array(z.string()).min(1, "Elige una afección o «Ninguna»"),
});
type CF = z.infer<typeof schema>;
const EMPTY: CF = { full_name: "", national_id: "", phone: "", allergies_conditions: [] }; // sin selección previa: hay que elegir

/** Alta (sin `client`) o edición (con `client`). Con `repeatable` ofrece "Guardar y agregar otro".
 *  onDone(cliente, another): `another` = true cuando el modal debe seguir abierto para otro registro. */
export default function ClientModal({ client, repeatable = false, onClose, onDone }:
  { client?: Client; repeatable?: boolean; onClose: () => void; onDone: (c: Client, another: boolean) => void }) {
  const toast = useToast((t) => t.show), qc = useQueryClient();
  const { register, handleSubmit, watch, setValue, reset, formState: { errors, isSubmitting } } = useForm<CF>({
    resolver: zodResolver(schema), mode: "onBlur",
    defaultValues: client ? { full_name: client.full_name, national_id: client.national_id, phone: client.phone, allergies_conditions: client.allergies_conditions } : EMPTY
  });
  const [err, setErr] = useState<ApiError | null>(null);
  const sel = watch("allergies_conditions");

  // «Ninguna» es excluyente, pero ya nunca bloquea al resto: elegir una afección la reemplaza y pulsarla de nuevo la quita.
  const toggle = (a: string) => setValue("allergies_conditions",
    a === "Ninguna" ? (sel.includes("Ninguna") ? [] : ["Ninguna"])
      : sel.includes(a) ? sel.filter((x) => x !== a) : [...sel.filter((x) => x !== "Ninguna"), a], { shouldValidate: true });

  const save = (another: boolean) => handleSubmit(async (v) => {
    setErr(null);
    try {
      const { data } = client ? await api.put<Client>(`/clients/${client.id}`, v) : await api.post<Client>("/clients", v);
      qc.invalidateQueries({ queryKey: ["clients"] }); qc.invalidateQueries({ queryKey: ["client"] }); // las listas muestran a todos
      toast("ok", another ? `${data.full_name} registrado. Agrega el siguiente.` : "Cambio registrado");
      onDone(data, another);
      if (another) reset(EMPTY);
    } catch (e) { setErr(apiError(e)); }
  });

  const field = (k: "full_name" | "national_id" | "phone", label: string) => (
    <label className="block"><span className="mb-1 block text-xs">{label}</span>
      <input className={inputCls} {...register(k)} />
      {errors[k] && <span className={errCls}><AlertTriangle size={12} />{errors[k]?.message}</span>}</label>
  );
  return (
    <Modal title={client ? "Editar cliente" : "Nuevo cliente"} onClose={onClose} footer={<>
      <Button variant="text" onClick={onClose}>Cancelar</Button>
      {repeatable && !client && <Button variant="ghost" onClick={save(true)} disabled={isSubmitting}>Guardar y agregar otro</Button>}
      <Button variant="primary" onClick={save(false)} disabled={isSubmitting}>Guardar cliente</Button></>}>
      <form onSubmit={save(false)} className="space-y-3">
        {field("full_name", "Nombre completo")}{field("national_id", "Cédula")}{field("phone", "Teléfono")}
        <div><span className="mb-1 block text-xs">Afección / condición (elige una o varias)</span>
          <div className="flex flex-wrap gap-2">
            {ALLERGIES.map((a) => (
              <button type="button" key={a} aria-pressed={sel.includes(a)} onClick={() => toggle(a)}
                className={`rounded-full border px-3 py-1 text-xs ${sel.includes(a) ? "border-olive bg-olive text-bone" : "border-beige bg-beige/30 text-olive hover:bg-beige/50"}`}>{a}</button>))}
          </div>
          {errors.allergies_conditions && <span className={errCls}><AlertTriangle size={12} />{errors.allergies_conditions.message}</span>}</div>
        {err && <div className={errCls}><AlertTriangle size={14} />{err.message}
          {err.client_id && <button type="button" className="ml-2 underline" onClick={async () => onDone((await api.get<Client>(`/clients/${err.client_id}`)).data, false)}>Usar ficha existente</button>}</div>}
      </form>
    </Modal>
  );
}
</file>

<file path="frontend/src/pages/Calendar.tsx">
import { addDays, addMonths, addWeeks, eachDayOfInterval, endOfMonth, endOfWeek, format, getDay, parseISO, startOfMonth, startOfWeek, subDays, subMonths, subWeeks } from "date-fns";
import { es } from "date-fns/locale";
import { CalendarDays, ChevronRight, Clock, DollarSign, Filter, Phone } from "lucide-react";
import { useState } from "react";
import type { Appt, Status } from "../api";
import { bs, useAppts, useNames, usd } from "../data";
import { Card, EmptyState, StatusBadge, inputCls } from "../ui";

type View = "month" | "week" | "day";
const STATUSES: Status[] = ["Programada", "Confirmada", "Atendida", "No asistió", "Cancelada", "Reagendada"];
const DENSITY = ["bg-bone", "bg-olive/10", "bg-olive/25", "bg-olive/45", "bg-olive/70 text-bone"]; // un solo hue: beige → oliva
const iso = (d: Date) => format(d, "yyyy-MM-dd");
const isNoShow = (a: Appt) => a.status === "No asistió" || a.status === "Reagendada";

export default function CalendarPage() {
  const [view, setView] = useState<View>("month");
  const [cur, setCur] = useState(new Date());
  const [f, setF] = useState({ worker: "", cubicle: "", status: "" });
  const names = useNames();

  const [from, to] = view === "month" ? [startOfMonth(cur), endOfMonth(cur)]
    : view === "week" ? [startOfWeek(cur, { weekStartsOn: 1 }), endOfWeek(cur, { weekStartsOn: 1 })] : [cur, cur];
  const q = useAppts({ date_from: iso(from), date_to: iso(to), worker_id: f.worker || undefined, cubicle_id: f.cubicle || undefined,
    status: f.status ? [f.status] : undefined });

  const byDay = new Map<string, Appt[]>();
  q.data?.forEach((a) => byDay.set(a.start_at.slice(0, 10), [...(byDay.get(a.start_at.slice(0, 10)) ?? []), a]));
  const step = (dir: 1 | -1) => setCur(view === "month" ? (dir > 0 ? addMonths(cur, 1) : subMonths(cur, 1))
    : view === "week" ? (dir > 0 ? addWeeks(cur, 1) : subWeeks(cur, 1)) : (dir > 0 ? addDays(cur, 1) : subDays(cur, 1)));
  const title = view === "day" ? format(cur, "EEEE d 'de' MMMM", { locale: es }) : view === "week"
    ? `${format(from, "d MMM", { locale: es })} – ${format(to, "d MMM yyyy", { locale: es })}` : format(cur, "MMMM yyyy", { locale: es });
  const sel = (k: keyof typeof f, label: string, opts: { v: string; l: string }[]) => (
    <select aria-label={label} className={`${inputCls} w-auto`} value={f[k]} onChange={(e) => setF({ ...f, [k]: e.target.value })}>
      <option value="">{label}</option>{opts.map((o) => <option key={o.v} value={o.v}>{o.l}</option>)}</select>);

  return (
    <div className={`transition-opacity duration-300 ${q.isFetching ? "opacity-70" : ""}`}>
      <h1 className="mb-4 flex items-center gap-2"><CalendarDays size={24} strokeWidth={1.5} />Calendario</h1>
      <div className="mb-4 flex flex-wrap items-center gap-2">
        <div className="flex overflow-hidden rounded-ctl border border-olive/20">
          {(["month", "week", "day"] as View[]).map((v) => (
            <button key={v} onClick={() => setView(v)} className={`px-3 py-1.5 ${view === v ? "bg-olive text-bone" : "text-olive"}`}>{{ month: "Mes", week: "Semana", day: "Día" }[v]}</button>))}
        </div>
        <button onClick={() => step(-1)} className="px-2 text-olive" aria-label="Anterior">‹</button>
        <span className="min-w-40 text-center font-semibold capitalize text-olive">{title}</span>
        <button onClick={() => step(1)} className="px-2 text-olive" aria-label="Siguiente">›</button>
        <button onClick={() => setCur(new Date())} className="text-xs underline">Hoy</button>
        <span className="ml-auto flex flex-wrap items-center gap-2"><Filter size={18} strokeWidth={1.5} className="text-olive" />
          {names.options && sel("worker", "Trabajador", names.options.workers.map((w) => ({ v: String(w.id), l: w.name })))}
          {names.options && sel("cubicle", "Cubículo", names.options.cubicles.map((c) => ({ v: String(c.id), l: c.name })))}
          {sel("status", "Estado", STATUSES.map((s) => ({ v: s, l: s })))}</span>
      </div>

      {view === "month" && <MonthGrid cur={cur} byDay={byDay} onPick={(d) => { setCur(d); setView("day"); }} />}
      {view === "week" && (
        <div className="grid gap-2 md:grid-cols-7">
          {eachDayOfInterval({ start: from, end: to }).map((d) => (
            <Card key={iso(d)} className="p-2">
              <button onClick={() => { setCur(d); setView("day"); }} className="mb-1 block w-full text-left text-xs font-semibold capitalize text-olive">{format(d, "EEE d", { locale: es })}</button>
              {(byDay.get(iso(d)) ?? []).map((a) => (
                <div key={a.id} className="mb-1 rounded-ctl bg-bone p-1.5 text-xs"><span className="font-semibold text-olive">{format(parseISO(a.start_at), "HH:mm")}</span> {a.client_name}<div className="mt-1"><StatusBadge status={a.status} /></div></div>))}
            </Card>))}
        </div>)}
      {view === "day" && (
        <div className="mx-auto max-w-2xl space-y-3">
          {q.data?.length === 0 && <EmptyState icon={<CalendarDays />} text="No hay citas este día." />}
          {q.data?.map((a) => <DayCard key={a.id} a={a} worker={names.worker(a.worker_id)} cubicle={names.cubicle(a.cubicle_id)} />)}
        </div>)}

      <div className="mt-6 flex flex-wrap gap-2" aria-label="Leyenda de estados">{STATUSES.map((s) => <StatusBadge key={s} status={s} />)}</div>
    </div>
  );
}

function MonthGrid({ cur, byDay, onPick }: { cur: Date; byDay: Map<string, Appt[]>; onPick: (d: Date) => void }) {
  const cells = eachDayOfInterval({ start: startOfMonth(cur), end: endOfMonth(cur) });
  const count = (d: Date) => (byDay.get(iso(d)) ?? []).filter((a) => a.status !== "Cancelada").length;
  const max = Math.max(1, ...cells.map(count));
  return (
    <div className="grid grid-cols-7 gap-1 text-center text-xs">
      {["Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom"].map((d) => <span key={d} className="py-1 text-olive/60">{d}</span>)}
      {Array.from({ length: (getDay(cells[0]) + 6) % 7 }).map((_, i) => <span key={`b${i}`} />)}
      {cells.map((d) => {
        const n = count(d), lvl = n === 0 ? 0 : Math.max(1, Math.ceil((n / max) * 4)), dot = (byDay.get(iso(d)) ?? []).some(isNoShow);
        return (
          <button key={iso(d)} onClick={() => onPick(d)} className={`relative flex h-16 flex-col items-center justify-center rounded-ctl border border-beige/60 ${DENSITY[lvl]}`}>
            <span>{d.getDate()}</span>{n > 0 && <span className="text-[10px] opacity-80">{n} cita{n > 1 ? "s" : ""}</span>}
            {dot && <span className="absolute right-1.5 top-1.5 h-2 w-2 rounded-full bg-terracotta" title="Hubo no-asistencias" />}
          </button>);
      })}
    </div>
  );
}

function DayCard({ a, worker, cubicle }: { a: Appt; worker: string; cubicle: string }) {
  return (
    <Card className="p-4">
      <div className="flex items-start justify-between gap-2">
        <div><p className="font-semibold text-olive">{format(parseISO(a.start_at), "HH:mm")} – {format(parseISO(a.end_at), "HH:mm")} · {a.client_name}</p>
          <p className="flex items-center gap-1 text-xs"><Phone size={14} strokeWidth={1.5} />{a.client_phone}</p></div>
        <StatusBadge status={a.status} />
      </div>
      <p className="mt-2">{a.zones.join(", ")}</p>
      <p className="mt-1 flex flex-wrap items-center gap-x-4 text-xs">
        <span className="flex items-center gap-1"><Clock size={14} strokeWidth={1.5} />{a.duration_min} min</span><span>{cubicle}</span><span>{worker}</span>
        <span className="flex items-center gap-1"><DollarSign size={14} strokeWidth={1.5} />{usd(a.price_usd)}{a.price_bs != null && ` · ${bs(a.price_bs)}`}</span></p>
      {a.rescheduled_to && <p className="mt-2 flex items-center gap-1 text-xs text-terracotta"><ChevronRight size={14} strokeWidth={1.5} />↳ Reagendada → {format(parseISO(a.rescheduled_to.start_at), "dd/MM")}</p>}
    </Card>
  );
}
</file>

<file path="frontend/src/pages/Clients.tsx">
import { useQuery } from "@tanstack/react-query";
import { format, parseISO } from "date-fns";
import { Pencil, Phone, Plus, Search, Users } from "lucide-react";
import { useState } from "react";
import { Link, useNavigate, useParams, useSearchParams } from "react-router-dom";
import { api, type Appt, type Client } from "../api";
import ClientModal from "../components/ClientModal";
import { bs, usd } from "../data";
import { Button, Card, EmptyState, StatusBadge, inputCls } from "../ui";

export function ClientsPage() {
  const [params, setParams] = useSearchParams();
  const q = params.get("q") ?? "";
  const [modal, setModal] = useState(false);
  const nav = useNavigate();
  const res = useQuery({ queryKey: ["clients", q], queryFn: async () => (await api.get<Client[]>("/clients", { params: { q } })).data });
  return (
    <div className="mx-auto max-w-3xl">
      <h1 className="mb-4 flex items-center gap-2"><Users size={24} strokeWidth={1.5} />Clientes</h1>
      <div className="mb-4 flex gap-2">
        <div className="relative flex-1"><Search size={18} strokeWidth={1.5} className="absolute left-3 top-2.5 text-olive/60" />
          <input className={`${inputCls} pl-9`} placeholder="Buscar por cédula o nombre" value={q} onChange={(e) => setParams(e.target.value ? { q: e.target.value } : {})} /></div>
        <Button variant="primary" onClick={() => setModal(true)}><Plus size={18} strokeWidth={1.5} />Nuevo cliente</Button>
      </div>
      {res.data?.length === 0 && <EmptyState icon={<Users />} text="No hay clientes que coincidan." />}
      <div className="space-y-2">
        {res.data?.map((c) => (
          <Link key={c.id} to={`/clientes/${c.id}`}>
            <Card className="mb-2 flex flex-wrap items-center justify-between gap-2 p-3 hover:bg-bone">
              <span><span className="block font-semibold text-olive">{c.full_name}</span><span className="text-xs">{c.national_id}</span></span>
              <span className="flex items-center gap-1 text-xs"><Phone size={14} strokeWidth={1.5} />{c.phone}</span>
              <span className="text-xs">{c.total_appointments ?? 0} citas · última: {c.last_appointment ? format(parseISO(c.last_appointment), "dd/MM/yyyy") : "—"}</span>
            </Card>
          </Link>))}
      </div>
      {modal && <ClientModal onClose={() => setModal(false)} onDone={(c) => nav(`/clientes/${c.id}`)} />}
    </div>
  );
}

export function ClientDetail() {
  const { id } = useParams();
  const [edit, setEdit] = useState(false);
  const q = useQuery({ queryKey: ["client", id], queryFn: async () => (await api.get<Client & { history: Appt[]; total_appointments: number }>(`/clients/${id}`)).data });
  if (q.isError) return <EmptyState icon={<Users />} text="No se encontró el cliente."><Link to="/clientes"><Button>Volver a clientes</Button></Link></EmptyState>;
  const c = q.data;
  if (!c) return null;
  return (
    <div className="mx-auto max-w-3xl">
      <Card className="mb-4 flex flex-wrap items-center gap-4 p-5">
        <span className="flex h-14 w-14 items-center justify-center rounded-full bg-olive text-xl uppercase text-bone">{c.full_name[0]}</span>
        <div className="flex-1">
          <h1>{c.full_name}</h1>
          <p className="text-xs">{c.national_id} · <Phone size={12} className="inline" strokeWidth={1.5} /> {c.phone} · {c.total_appointments} cita{c.total_appointments === 1 ? "" : "s"}</p>
          <div className="mt-2 flex flex-wrap gap-1.5">{c.allergies_conditions.map((a) => <span key={a} className="rounded-full bg-beige/40 px-2.5 py-0.5 text-xs text-olive">{a}</span>)}</div>
        </div>
        <Button onClick={() => setEdit(true)}><Pencil size={18} strokeWidth={1.5} />Editar</Button>
      </Card>
      <h2 className="mb-2 text-lg">Historial</h2>
      {c.history.length === 0 && <EmptyState icon={<Users />} text="Este cliente aún no tiene citas." />}
      <div className="space-y-2">
        {c.history.map((a) => (
          <Card key={a.id} className="p-3">
            <div className="flex flex-wrap items-center justify-between gap-2">
              <span className="font-semibold text-olive">{format(parseISO(a.start_at), "dd/MM/yyyy HH:mm")}</span><StatusBadge status={a.status} />
            </div>
            <p className="mt-1">{a.zones.join(", ")} · {a.duration_min} min</p>
            <p className="text-xs">{usd(a.price_usd)}{a.price_bs != null && ` · ${bs(a.price_bs)} (tasa ${a.bcv_rate})`}</p>
            {a.observations && <p className="mt-1 text-xs italic">{a.observations}</p>}
            {a.rescheduled_to && <p className="mt-1 text-xs text-terracotta">↳ Reagendada → {format(parseISO(a.rescheduled_to.start_at), "dd/MM")}</p>}
          </Card>))}
      </div>
      {edit && <ClientModal client={c} onClose={() => setEdit(false)} onDone={() => { setEdit(false); q.refetch(); }} />}
    </div>
  );
}
</file>

<file path="frontend/src/pages/Dashboard.tsx">
import { useMutation, useQueryClient } from "@tanstack/react-query";
import { format, parseISO } from "date-fns";
import { Activity, CalendarClock, CalendarDays, CheckCircle2, DoorOpen, Hourglass, LayoutDashboard, UserX } from "lucide-react";
import { useState, type ReactNode } from "react";
import { Link } from "react-router-dom";
import { api, apiError, type Appt } from "../api";
import Timeline from "../components/panel/Timeline";
import WeekHeat from "../components/panel/Weekheat";
import { useAppts, useNames } from "../data";
import { useToast } from "../store";
import { Button, Card } from "../ui";
import { AttendModal, NoShowModal } from "./DayManagement";

type Col = "pending" | "reception" | "treatment" | "done";
const COLS: { id: Col; title: string; icon: ReactNode; tone: string }[] = [
  { id: "pending", title: "Por llegar / Agendadas", icon: <CalendarClock size={18} strokeWidth={1.5} />, tone: "border-sky-300 bg-sky-50" },
  { id: "reception", title: "En recepción / Espera", icon: <Hourglass size={18} strokeWidth={1.5} />, tone: "border-amber-300 bg-amber-50" },
  { id: "treatment", title: "En tratamiento", icon: <Activity size={18} strokeWidth={1.5} />, tone: "border-violet-300 bg-violet-50" },
  { id: "done", title: "Completado / Salida", icon: <CheckCircle2 size={18} strokeWidth={1.5} />, tone: "border-emerald-300 bg-emerald-50" },
];
const stageOf = (a: Appt): Col => a.status === "Atendida" ? "done" : a.flow_stage === "treatment" ? "treatment" : a.flow_stage === "reception" ? "reception" : "pending";

function Kpi({ icon, label, value, sub, grad }: { icon: ReactNode; label: string; value: string | number; sub: string; grad: string }) {
  return (
    <div className={`rounded-card bg-gradient-to-br ${grad} p-4 text-white shadow-soft`}>
      <div className="flex items-center justify-between text-sm opacity-95"><span>{label}</span>{icon}</div>
      <p className="mt-2 text-[32px] font-semibold leading-none">{value}</p>
      <p className="mt-1 text-xs opacity-95">{sub}</p>
    </div>);
}

export default function Dashboard() {
  const q = useAppts({ date: format(new Date(), "yyyy-MM-dd") });
  const names = useNames(), qc = useQueryClient(), toast = useToast((t) => t.show);
  const [tab, setTab] = useState<"agenda" | "week">("agenda");
  const [modal, setModal] = useState<{ kind: "attend" | "noshow"; a: Appt } | null>(null);

  const today = (q.data ?? []).filter((a) => a.status !== "Cancelada");
  const board = today.filter((a) => ["Programada", "Confirmada", "Atendida"].includes(a.status));
  const done = today.filter((a) => a.status === "Atendida").length;
  const absent = today.filter((a) => a.status === "No asistió" || a.status === "Reagendada").length;
  const cubActive = names.options?.cubicles.length ?? 0, cubTotal = names.options?.cubicles_total ?? 0;
  const ic = { size: 24, strokeWidth: 1.5 };

  const stage = useMutation({
    mutationFn: (p: { id: number; stage: "reception" | "treatment" | null }) => api.post(`/appointments/${p.id}/stage`, { stage: p.stage }),
    onSuccess: () => qc.invalidateQueries({ queryKey: ["appts"] }), onError: (e) => toast("error", apiError(e).message),
  });
  const move = (a: Appt, s: "reception" | "treatment" | null) => stage.mutate({ id: a.id, stage: s });
  const sm = "px-3 py-1.5 text-xs";

  const actions = (a: Appt, col: Col) => ({
    pending: <><Button variant="primary" className={sm} onClick={() => move(a, "reception")} disabled={stage.isPending}>Llegó</Button>
      <Button variant="text" className={`${sm} text-terracotta`} onClick={() => setModal({ kind: "noshow", a })}>No asistió</Button></>,
    reception: <><Button variant="primary" className={sm} onClick={() => move(a, "treatment")} disabled={stage.isPending}>Pasar a sala</Button>
      <Button variant="text" className={sm} onClick={() => move(a, null)}>Volver</Button></>,
    treatment: <><Button variant="primary" className={sm} onClick={() => setModal({ kind: "attend", a })}>Finalizar</Button>
      <Button variant="text" className={sm} onClick={() => move(a, "reception")}>Volver</Button></>,
    done: <Link to="/citas" className="text-xs text-emerald-700 underline">Agendar próxima sesión</Link>,
  })[col];

  return (
    <div>
      <h1 className="mb-4 flex items-center gap-2"><LayoutDashboard size={24} strokeWidth={1.5} />Panel</h1>

      <div className="mb-6 grid grid-cols-2 gap-3 lg:grid-cols-4">
        <Kpi grad="from-violet-500 to-indigo-500" icon={<CalendarDays {...ic} />} label="Citas del día" value={today.length} sub="Citas" />
        <Kpi grad="from-emerald-500 to-teal-500" icon={<CheckCircle2 {...ic} />} label="Atendidas" value={done} sub="Completadas" />
        <Kpi grad="from-orange-400 to-rose-500" icon={<UserX {...ic} />} label="No asistió" value={absent} sub="Ausencias" />
        <Kpi grad="from-sky-500 to-blue-600" icon={<DoorOpen {...ic} />} label="Cubículos activos" value={`${cubActive} / ${cubTotal}`} sub="Activos" />
      </div>

      <h2 className="mb-2 text-lg">Flujo de atención</h2>
      <div className="mb-6 grid gap-3 md:grid-cols-2 xl:grid-cols-4">
        {COLS.map((col) => {
          const items = board.filter((a) => stageOf(a) === col.id).sort((a, b) => a.start_at.localeCompare(b.start_at));
          return (
            <div key={col.id} className={`rounded-card border p-3 ${col.tone}`}>
              <div className="mb-2 flex items-center justify-between text-sm font-semibold text-slate-700"><span className="flex items-center gap-1.5">{col.icon}{col.title}</span>
                <span className="rounded-full bg-white/80 px-2 text-xs">{items.length}</span></div>
              <div className="space-y-2">
                {items.length === 0 && <p className="py-4 text-center text-xs text-slate-500">Sin pacientes</p>}
                {items.map((a) => (
                  <div key={a.id} className="rounded-ctl bg-white p-2.5 shadow-sm">
                    <p className="text-sm font-semibold text-slate-800">{format(parseISO(a.start_at), "HH:mm")} · {a.client_name}</p>
                    <p className="text-xs text-slate-600">{a.zones.join(", ")}</p>
                    <p className="text-xs text-slate-500">{names.cubicle(a.cubicle_id)} · {names.worker(a.worker_id)}</p>
                    <div className="mt-2 flex flex-wrap items-center gap-1.5">{actions(a, col.id)}</div>
                  </div>))}
              </div>
            </div>);
        })}
      </div>

      <Card className="p-4">
        <div className="mb-3 flex border-b border-beige">
          {([["agenda", "Agenda de hoy"], ["week", "Ocupación semanal"]] as const).map(([id, label]) => (
            <button key={id} onClick={() => setTab(id)} className={`border-b-2 px-4 py-2 ${tab === id ? "border-olive font-semibold text-olive" : "border-transparent"}`}>{label}</button>))}
        </div>
        {tab === "agenda"
          ? <Timeline appts={today} cubicles={names.options?.cubicles ?? []} open={names.options?.business_hours.open ?? "08:00"} close={names.options?.business_hours.close ?? "19:00"}
            cubicleName={names.cubicle} workerName={names.worker} />
          : <WeekHeat />}
      </Card>

      {modal?.kind === "attend" && <AttendModal a={modal.a} onClose={() => setModal(null)} />}
      {modal?.kind === "noshow" && <NoShowModal a={modal.a} onClose={() => setModal(null)} />}
    </div>
  );
}
